node_modules/
.DS_Store
*.log

# `.claude/settings.local.json` is per-machine and never shared.
.claude/settings.local.json

# `settings-policy.mjs --write` drops a timestamped backup beside the file it edits.
# Nothing gitignored them in seeds, so every write left another one staged for commit.
*.bak
*.bak.*

# The sessions branch is checked out here by /its-alive.
.sessions-worktree/

# throughput.py is the only Python here; py_compile drops these beside it.
__pycache__/
*.pyc
